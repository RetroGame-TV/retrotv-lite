set(QUICKNES_DIR ${CMAKE_CURRENT_LIST_DIR}/../third_party/quicknes)
file(GLOB QUICKNES_SOURCES CONFIGURE_DEPENDS ${QUICKNES_DIR}/nes_emu/*.cpp)
add_library(quicknes_libretro SHARED ${QUICKNES_DIR}/libretro/libretro.cpp ${QUICKNES_SOURCES})
target_include_directories(quicknes_libretro PRIVATE ${QUICKNES_DIR} ${QUICKNES_DIR}/nes_emu ${QUICKNES_DIR}/libretro ${QUICKNES_DIR}/libretro/libretro-common/include)
target_compile_definitions(quicknes_libretro PRIVATE __LIBRETRO__ NO_UNALIGNED_ACCESS GIT_VERSION="26bb785")
target_compile_options(quicknes_libretro PRIVATE -O2 -fno-strict-aliasing -Wno-narrowing)
if(ANDROID)
  target_link_libraries(quicknes_libretro m log)
endif()
